{
  "branches": [
    "main",
    {
      "name": "beta",
      "prerelease": "beta",
      "channel": "beta"
    },
    {
      "name": "alpha",
      "prerelease": "alpha",
      "channel": "alpha"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "Core/build/libs/*.jar",
            "label": false
          },
          {
            "path": "Bungeecord/build/libs/*.jar",
            "label": false
          },
          {
            "path": "Spigot/build/libs/*.jar",
            "label": false
          },
          {
            "path": "Velocity/build/libs/*.jar",
            "label": false
          },
          {
            "path": "Fabric/build/libs/*.jar",
            "label": false
          },
          {
            "path": "Core/build/libs/*.zip",
            "label": false
          },
          {
            "path": "Bungeecord/build/libs/*.zip",
            "label": false
          },
          {
            "path": "Spigot/build/libs/*.zip",
            "label": false
          },
          {
            "path": "Velocity/build/libs/*.zip",
            "label": false
          },
          {
            "path": "Fabric/build/libs/*.zip",
            "label": false
          },
          {
            "path": "LICENSE",
            "label": false
          }
        ]
      }
    ]
  ],
  "repositoryUrl": "https://github.com/PanoMC/pano-mc-plugin.git"
}